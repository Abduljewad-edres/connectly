PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/connectly?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_development_or_production
CLIENT_URL=https://connectly-kt1p.onrender.com

# Cloudinary CDN for Permanent Video & Image Storage (Free at https://cloudinary.com)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or alternatively:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional: Google Cloud Translation API key or MyMemory email
GOOGLE_TRANSLATE_API_KEY=
MYMEMORY_EMAIL=

